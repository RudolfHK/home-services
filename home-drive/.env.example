# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in every value before running
#   cp .env.example .env && chmod 600 .env && nano .env
# NEVER commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────

# ── Tailscale ────────────────────────────────────────────────
# Generate a reusable auth key in https://login.tailscale.com/admin/settings/keys
# Tick "Reusable" so the container can re-authenticate after restarts.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Hostname the Pi will appear as in the tailnet (no dots)
TS_HOSTNAME=homepi

# Your tailnet name, shown in the admin console (e.g. "tail1234.ts.net").
# Used only to print URLs in install.sh and the docs — serve.json derives the
# real hostname from ${TS_CERT_DOMAIN} at runtime.
TS_TAILNET=tail1234.ts.net

# Extra tailscale args (leave empty unless you know what you're doing)
TS_EXTRA_ARGS=

# ── CouchDB ──────────────────────────────────────────────────
COUCHDB_USER=admin
COUCHDB_PASSWORD=change_me_strong_password

# Name of the Obsidian database (created automatically by LiveSync plugin)
COUCHDB_OBSIDIAN_DB=obsidian

# ── FileBrowser ──────────────────────────────────────────────
# FileBrowser creates its admin account on first start. Left alone it uses a
# well-known default password, which on a file server is a real hole — so
# install.sh resets the account to these values every time it runs.
# Plaintext here (install.sh hashes it via `filebrowser users update`); keep
# .env at mode 0600.
FILEBROWSER_ADMIN_USER=admin
FILEBROWSER_ADMIN_PASSWORD=change_me_strong_password

# ── Nextcloud (the drive) ────────────────────────────────────
# Google-Drive-style storage: browser UI, desktop and mobile sync clients,
# users, sharing, versioning and file locking. Install with:
#   bash scripts/install-drive.sh
# Reached at https://${TS_HOSTNAME}.${TS_TAILNET}:9443/ — see docs/DRIVE.md.

# The first administrator account, created on the very first start only.
# Changing these later does nothing; change the password in the web UI instead.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_strong_password

# PostgreSQL. Nothing else uses this database; the password is never typed by a
# human, so make it long and random:  openssl rand -base64 32
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=change_me_strong_password

# Redis. This is not just a cache: it is the lock manager that stops two
# devices writing the same file at once. Also never typed by a human.
NEXTCLOUD_REDIS_PASSWORD=change_me_strong_password

# Port `tailscale serve` publishes the drive on.
# Nextcloud is given its own port rather than a path under the main hostname:
# running it in a subdirectory needs webroot rewriting plus special handling for
# /.well-known, and breaks CalDAV/CardDAV discovery in ways that are painful to
# debug. If you change this you must also change it in
# config/tailscale/serve.json, which is static JSON and cannot read .env.
NEXTCLOUD_PORT=9443

# Two-letter country code used to interpret phone numbers (silences a setup
# warning). https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2
NEXTCLOUD_PHONE_REGION=GB

# Resource limits. The defaults suit a 4 GB Pi 5; raise PHP memory if you enable
# heavy apps, and lower the Redis cap if the box is tight on RAM.
NEXTCLOUD_PHP_MEMORY=512M
NEXTCLOUD_UPLOAD_LIMIT=16G
NEXTCLOUD_REDIS_MAXMEM=256mb

# The drive's containers live behind a compose profile, so that a stack without
# it is unaffected by install.sh. install-drive.sh appends the line below once
# the drive is installed; with it, plain `docker compose up -d` / `down` / `ps`
# cover the whole stack. Do NOT uncomment it by hand before running
# install-drive.sh — compose would then try to start the drive before its data
# directories exist.
#COMPOSE_PROFILES=drive

# Image tags. As with the other services: pin these once the stack works.
#   NEXTCLOUD_TAG=31-fpm
NEXTCLOUD_TAG=stable-fpm
POSTGRES_TAG=16-alpine
REDIS_TAG=7-alpine
NGINX_TAG=alpine

# ── Data paths ───────────────────────────────────────────────
# Absolute path on the HOST where the external data drive is mounted.
# Run scripts/mount-drive.sh to set this up.
# The bind mounts use create_host_path: false, so if this path (or its
# files/ filebrowser/ couchdb/ subdirectories) is missing, the stack refuses to
# start rather than quietly writing to the OS drive.
DATA_PATH=/mnt/data

# ── System ───────────────────────────────────────────────────
# Timezone string from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/London

# UID / GID of the host user that owns the data files (run `id -u` / `id -g`).
# FileBrowser runs as this user; CouchDB's entrypoint manages its own uid.
PUID=1000
PGID=1000

# ── Image tags ───────────────────────────────────────────────
# Defaults track the latest published image. Once the stack is working, pin
# these to the exact versions you validated so a `docker compose pull` cannot
# change behaviour under you.
#   TAILSCALE_TAG=v1.80.3
#   FILEBROWSER_TAG=v2.31.2
TAILSCALE_TAG=latest
FILEBROWSER_TAG=latest
COUCHDB_TAG=3

# ── Backup ───────────────────────────────────────────────────
# How many daily backup archives to keep before rotating
BACKUP_KEEP=7

# Where archives are written (defaults to ${DATA_PATH}/backups)
#BACKUP_DEST=/mnt/data/backups

# Include the FileBrowser file tree in the archive. Off by default: on a
# multi-terabyte drive this turns a 30-second job into an hours-long one that
# needs as much free space again. Use rclone/rsync for the file tree instead.
BACKUP_INCLUDE_FILES=false

# Include the Nextcloud user files in the archive. Off for the same reason.
# The database and config are ALWAYS backed up regardless of this setting —
# without them the files are just a directory tree with no shares, versions or
# accounts attached.
BACKUP_INCLUDE_NEXTCLOUD_DATA=false

# Optional: rclone remote name for off-Pi backup (leave empty to skip)
RCLONE_REMOTE=

# Optional: ntfy topic URL for health check notifications (leave empty to skip)
#   e.g. https://ntfy.sh/my-secret-topic
NTFY_URL=

# ── Monitoring ───────────────────────────────────────────────
# Used by scripts/health-monitor.sh (unattended, from a systemd timer) and
# scripts/health-dashboard.sh (the status screen). Install both with:
#   bash scripts/install-monitoring.sh
# Every value below has a working default — set them only to change behaviour.
# See docs/MONITORING.md.

# Where deltas, history and the file manifest are kept. Must NOT be on the data
# drive: the monitor has to keep working when that drive goes missing.
#HEALTH_STATE_DIR=/var/lib/homedrive

# Show the result on a screen attached to the Pi after every scheduled check.
#   auto  = only when a display is actually connected (default)
#   off   = never
#   force = always, even if no display is detected
#HEALTH_DISPLAY=auto
#HEALTH_DISPLAY_SECONDS=5
#HEALTH_DISPLAY_TTY=/dev/tty1
# Console font while the status is on screen — bigger is readable across a room.
# List what is installed with: ls /usr/share/consolefonts/
#HEALTH_DISPLAY_FONT=Uni2-Terminus32x16

# Alert thresholds (percentages, °C, hours).
#HEALTH_DISK_WARN=75
#HEALTH_DISK_CRIT=90
#HEALTH_ROOT_WARN=85
#HEALTH_ROOT_CRIT=95
#HEALTH_TEMP_WARN=70
#HEALTH_TEMP_CRIT=80
#HEALTH_MEM_WARN=85
#HEALTH_MEM_CRIT=95
#HEALTH_BACKUP_WARN_H=26
#HEALTH_BACKUP_CRIT_H=48

# Page on CPU/RAM/load spikes too. Off by default: a file server under load is
# doing its job, and an alert that fires during normal use gets muted.
#HEALTH_ALERT_ON_RESOURCE=false

# Do not re-send an unchanged alert more often than this.
#HEALTH_ALERT_REPEAT_HOURS=6

# File activity scanning (recently edited/uploaded/deleted files).
# The scan walks the whole file tree's metadata, so it is cached between runs
# and time-boxed. Change tracking is skipped above MAX_FILES to bound memory.
#HEALTH_SCAN_INTERVAL_MIN=30
#HEALTH_SCAN_TIMEOUT=90
#HEALTH_SCAN_MAX_FILES=200000
#HEALTH_RECENT_COUNT=8
# Warn when at least this many files vanish between two checks.
#HEALTH_DELETE_WARN=50
