# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in every value before running
#   cp .env.example .env && chmod 600 .env && nano .env
# NEVER commit .env to git: it contains secrets.
# ─────────────────────────────────────────────────────────────

# ── Nextcloud (the drive) ────────────────────────────────────
# Google-Drive-style storage: browser UI, desktop and mobile sync clients,
# users, sharing, versioning and file locking. Install with:
#   bash scripts/install.sh
# Reached at http://${NEXTCLOUD_LAN_HOSTNAME}:${NEXTCLOUD_PORT}/ from any
# device on the LAN or tailnet by default; see README.md. Enable the
# optional `tailscale` profile below to also reach it from outside the LAN.

# Hostname or IP clients on the LAN use to reach this box, e.g. the Pi's
# mDNS name ("homepi.local") or a static LAN IP. Added to
# NEXTCLOUD_TRUSTED_DOMAINS below so Nextcloud accepts requests addressed to
# it; get this wrong and every request is rejected with "untrusted domain".
NEXTCLOUD_LAN_HOSTNAME=homepi.local

# The first administrator account, created on the very first start only.
# Changing these later does nothing; change the password in the web UI instead.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_strong_password

# PostgreSQL. Nothing else uses this database; the password is never typed by a
# human, so make it long and random:  openssl rand -base64 32
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=change_me_strong_password

# Redis. This is not just a cache: it is the lock manager that stops two
# devices writing the same file at once. Also never typed by a human.
NEXTCLOUD_REDIS_PASSWORD=change_me_strong_password

# Port nginx publishes on the LAN. 80 works out of the box; if you already run
# something else on 80, change it here; no other file needs to know.
NEXTCLOUD_PORT=80

# Two-letter country code used to interpret phone numbers (silences a setup
# warning). https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2
NEXTCLOUD_PHONE_REGION=GB

# Resource limits. The defaults suit a 4 GB Pi 5; raise PHP memory if you enable
# heavy apps, and lower the Redis cap if the box is tight on RAM.
NEXTCLOUD_PHP_MEMORY=512M
NEXTCLOUD_UPLOAD_LIMIT=16G
NEXTCLOUD_REDIS_MAXMEM=256mb

# Image tags. As with the other services: pin these once the stack works.
#   NEXTCLOUD_TAG=31-fpm
NEXTCLOUD_TAG=stable-fpm
POSTGRES_TAG=16-alpine
REDIS_TAG=7-alpine
NGINX_TAG=alpine

# ── Data paths ───────────────────────────────────────────────
# Absolute path on the HOST where the external data drive is mounted.
# Run scripts/mount-drive.sh to set this up.
# The bind mounts use create_host_path: false, so if this path (or its
# nextcloud/ subdirectories) is missing, the stack refuses to start rather
# than quietly writing to the OS drive.
DATA_PATH=/mnt/data

# ── System ───────────────────────────────────────────────────
# Timezone string from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/London

# UID / GID of the host user that owns the data files (run `id -u` / `id -g`).
PUID=1000
PGID=1000

# ── Tailscale (optional: reach the drive from outside the LAN) ──────────
# home-drive is fully usable over the LAN with nothing below set. Fill these
# in and run `docker compose --profile tailscale up -d` (or
# `bash scripts/autostart.sh` once installed with the profile active) only if
# you also want it reachable from a tag-approved device off the LAN, over
# HTTPS via `tailscale serve`. See README.md's Tailscale section and
# ../tailscale/README.md before enabling this. Apply
# ../tailscale/acl-policy.hujson to your tailnet FIRST: without it this
# node's tag grants nothing.
TAILSCALE_TAG=latest

# Generate this key just for this node's first `tailscale up` at
# https://login.tailscale.com/admin/settings/keys, preferring NOT reusable
# and a short expiry (an hour is plenty) over "reusable, tick a long expiry":
# the state volume is persistent, so the key is only ever consulted once;
# every restart after that re-authenticates from cached state, not the key.
# A key that can't be reused has nothing left to steal if it ever leaks.
TS_AUTHKEY=

# Hostname the Pi will appear as in the tailnet (no dots).
TS_HOSTNAME=homepi

# Your tailnet name, shown in the admin console (e.g. "tail1234.ts.net").
# Added to NEXTCLOUD_TRUSTED_DOMAINS automatically; serve.json derives the
# real hostname from ${TS_CERT_DOMAIN} at runtime, so this is only used for
# that trusted-domain entry and to print URLs in install.sh and the docs.
TS_TAILNET=tail1234.ts.net

# --advertise-tags=tag:home-drive-server is required for
# ../tailscale/acl-policy.hujson to grant this node anything at all. See
# ../tailscale/docs/DEVICE-ONBOARDING.md.
TS_EXTRA_ARGS=--advertise-tags=tag:home-drive-server

# ── Backup ───────────────────────────────────────────────────
# How many daily backup archives to keep before rotating
BACKUP_KEEP=7

# Where archives are written (defaults to ${DATA_PATH}/backups)
#BACKUP_DEST=/mnt/data/backups

# Include the Nextcloud user files in the archive. Off by default: on a
# multi-terabyte drive this turns a 30-second job into an hours-long one that
# needs as much free space again. Use rclone/rsync for the file tree instead.
# The database and config are ALWAYS backed up regardless of this setting;
# without them the files are just a directory tree with no shares, versions or
# accounts attached.
BACKUP_INCLUDE_NEXTCLOUD_DATA=false

# Optional: rclone remote name for off-Pi backup (leave empty to skip)
RCLONE_REMOTE=

# Optional: ntfy topic URL for backup notifications (leave empty to skip)
#   e.g. https://ntfy.sh/my-secret-topic
NTFY_URL=
