# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in every value before running
#   cp .env.example .env && chmod 600 .env && nano .env
# NEVER commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────

# ── Tailscale ────────────────────────────────────────────────
# Generate a reusable auth key in https://login.tailscale.com/admin/settings/keys
# Tick "Reusable" so the container can re-authenticate after restarts.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Hostname the Pi will appear as in the tailnet (no dots)
TS_HOSTNAME=homepi

# Your tailnet name, shown in the admin console (e.g. "tail1234.ts.net").
# Used only to print URLs in install.sh and the docs — serve.json derives the
# real hostname from ${TS_CERT_DOMAIN} at runtime.
TS_TAILNET=tail1234.ts.net

# Extra tailscale args (leave empty unless you know what you're doing)
TS_EXTRA_ARGS=

# ── CouchDB ──────────────────────────────────────────────────
COUCHDB_USER=admin
COUCHDB_PASSWORD=change_me_strong_password

# Name of the Obsidian database (created automatically by LiveSync plugin)
COUCHDB_OBSIDIAN_DB=obsidian

# ── FileBrowser ──────────────────────────────────────────────
# FileBrowser creates its admin account on first start. Left alone it uses a
# well-known default password, which on a file server is a real hole — so
# install.sh resets the account to these values every time it runs.
# Plaintext here (install.sh hashes it via `filebrowser users update`); keep
# .env at mode 0600.
FILEBROWSER_ADMIN_USER=admin
FILEBROWSER_ADMIN_PASSWORD=change_me_strong_password

# ── Data paths ───────────────────────────────────────────────
# Absolute path on the HOST where the external data drive is mounted.
# Run scripts/mount-drive.sh to set this up.
# The bind mounts use create_host_path: false, so if this path (or its
# files/ filebrowser/ couchdb/ subdirectories) is missing, the stack refuses to
# start rather than quietly writing to the OS drive.
DATA_PATH=/mnt/data

# ── System ───────────────────────────────────────────────────
# Timezone string from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/London

# UID / GID of the host user that owns the data files (run `id -u` / `id -g`).
# FileBrowser runs as this user; CouchDB's entrypoint manages its own uid.
PUID=1000
PGID=1000

# ── Image tags ───────────────────────────────────────────────
# Defaults track the latest published image. Once the stack is working, pin
# these to the exact versions you validated so a `docker compose pull` cannot
# change behaviour under you.
#   TAILSCALE_TAG=v1.80.3
#   FILEBROWSER_TAG=v2.31.2
TAILSCALE_TAG=latest
FILEBROWSER_TAG=latest
COUCHDB_TAG=3

# ── Backup ───────────────────────────────────────────────────
# How many daily backup archives to keep before rotating
BACKUP_KEEP=7

# Where archives are written (defaults to ${DATA_PATH}/backups)
#BACKUP_DEST=/mnt/data/backups

# Include the FileBrowser file tree in the archive. Off by default: on a
# multi-terabyte drive this turns a 30-second job into an hours-long one that
# needs as much free space again. Use rclone/rsync for the file tree instead.
BACKUP_INCLUDE_FILES=false

# Optional: rclone remote name for off-Pi backup (leave empty to skip)
RCLONE_REMOTE=

# Optional: ntfy topic URL for health check notifications (leave empty to skip)
#   e.g. https://ntfy.sh/my-secret-topic
NTFY_URL=
