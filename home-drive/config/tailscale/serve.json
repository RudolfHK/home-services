{
  "TCP": {
    "443": {
      "HTTPS": true
    },
    "8443": {
      "HTTPS": true
    },
    "9443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:8080"
        },
        "/couchdb/": {
          "Proxy": "http://127.0.0.1:5984"
        }
      }
    },
    "${TS_CERT_DOMAIN}:8443": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:5984"
        }
      }
    },
    "${TS_CERT_DOMAIN}:9443": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:8081"
        }
      }
    }
  }
}
