# Home Drive — unattended health check.
# Installed by scripts/install-monitoring.sh, which substitutes @USER@ and
# @PROJECT@. Triggered by homedrive-health.timer, not enabled directly.
[Unit]
Description=Home Drive health check
Documentation=file://@PROJECT@/docs/MONITORING.md
# The check talks to Docker; running it before the daemon is up would report
# every container as missing and page you on every boot.
After=docker.service network-online.target
Wants=docker.service

[Service]
Type=oneshot
User=@USER@
# Needed to draw the result on /dev/tty1 after the check. Harmless on a headless
# Pi, where the flash is skipped because no display is detected.
SupplementaryGroups=tty
WorkingDirectory=@PROJECT@
# The script owns its own exit codes: 1 = warnings, 2 = failures. Both are
# expected outcomes of a health check, so systemd must not treat them as a
# service failure and start retrying.
SuccessExitStatus=0 1 2
ExecStart=@PROJECT@/scripts/health-monitor.sh --verbose

# The console flash needs a writable /dev/tty1; everything else is read-only
# system state plus the state directory.
ReadWritePaths=/var/lib/homedrive
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
