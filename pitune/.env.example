# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in every value before running
#   cp .env.example .env && chmod 600 .env && nano .env
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── System ───────────────────────────────────────────────────
# Timezone string from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/London

# UID/GID of the host user that owns MUSIC_PATH (run `id -u` / `id -g`).
# Navidrome runs as this user so it can read your library.
PUID=1000
PGID=1000

# ── Paths ────────────────────────────────────────────────────
# Your existing local music library (FLAC, MP3, etc). Read-only for Navidrome
# always; the backend also mounts it, read-only unless you enable
# DOWNLOAD_ENABLED below.
MUSIC_PATH=/home/pi/music

# Where Navidrome keeps its database, cache and search index. Keep this
# separate from MUSIC_PATH so a library rescan can never touch it.
NAVIDROME_DATA_PATH=/home/pi/pitune-data/navidrome

# ── Ports ────────────────────────────────────────────────────
# The one URL you actually use day to day: http://<pi>:<PITUNE_PORT>/
PITUNE_PORT=8096

# Navidrome's own port — its admin UI (create/manage users) and any Subsonic
# mobile app that talks to it directly instead of through PiTune's UI.
# Unlike PITUNE_PORT, nothing sits in front of this: no rate limiting, no
# security headers. Consider firewalling it to your own LAN subnet — see
# README.md's Security model for a ufw example.
NAVIDROME_PORT=4533

# ── Navidrome ────────────────────────────────────────────────
# Image tag. Pin this (e.g. NAVIDROME_TAG=0.54.1) once the stack works —
# `latest` can change behaviour under you on `docker compose pull`.
NAVIDROME_TAG=latest
ND_LOGLEVEL=info
# How often Navidrome rescans MUSIC_PATH for new/changed files.
ND_SCANSCHEDULE=@every 1h

# ── Backend / yt-dlp ─────────────────────────────────────────
# Max YouTube search results returned per query.
SEARCH_RESULT_LIMIT=20

# Leave empty. Same-origin requests through the frontend's reverse proxy
# are unaffected by CORS regardless — this exists only for someone bypassing
# it and calling the backend directly with their own separate frontend.
CORS_ORIGINS=

# Optional: absolute path on the HOST to a Netscape-format cookies.txt,
# exported from a browser logged into YouTube. Needed only for age-restricted
# or region-locked videos — leave unset otherwise.
#YTDLP_COOKIES_HOST_FILE=/home/pi/pitune-data/cookies.txt
YTDLP_COOKIES_HOST_FILE=

# Enables POST /api/save/<id> (not yet wired to a button in the UI — call it
# directly, or add one) — flip both of these together, since DOWNLOAD_ENABLED
# alone does nothing while the mount is read-only.
DOWNLOAD_ENABLED=false
MUSIC_MOUNT_MODE=true
# MUSIC_MOUNT_MODE is fed straight into compose's `read_only:` flag, so it
# takes "true"/"false", not "ro"/"rw". Set MUSIC_MOUNT_MODE=false to allow
# writes once DOWNLOAD_ENABLED=true.

# ── Security ─────────────────────────────────────────────────
# Required to use /api/save once DOWNLOAD_ENABLED=true above — without it,
# that endpoint has NO auth at all. `openssl rand -hex 32` to generate one.
API_TOKEN=

# ── Tailscale (optional — remote access from outside the LAN) ────────────
# Only used if you start the "tailscale" profile (`docker compose --profile
# tailscale up -d`) — see README.md's Tailscale section and
# ../tailscale/README.md before enabling this. Apply
# ../tailscale/acl-policy.hujson to your tailnet FIRST.
TAILSCALE_TAG=latest
TS_AUTHKEY=
TS_HOSTNAME=pitune
# --advertise-tags=tag:home-server — required for ../tailscale/acl-policy.hujson
# to grant this node anything at all. See ../tailscale/docs/DEVICE-ONBOARDING.md.
TS_EXTRA_ARGS=--advertise-tags=tag:home-server
