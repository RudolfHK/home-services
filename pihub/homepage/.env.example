# Only used when running homepage/docker-compose.yml STANDALONE. When
# homepage is part of the full PiHub stack, its config comes from
# ../.env instead — see ../docker-compose.yml.
#
#   cp .env.example .env

# The one port for standalone use.
HOMEPAGE_PORT=80

# Same media layout as the rest of PiHub — see ../.env.example.
MEDIA_ROOT=/media/storage

# Required to use start/stop/restart/logs — without it those endpoints have
# NO auth at all. `openssl rand -hex 32` to generate one.
API_TOKEN=

# Leave empty — see backend/main.py's CORS_ORIGINS comment for why a
# same-origin frontend+API never needs this widened.
CORS_ORIGINS=
