# Only used when running homepage/docker-compose.yml STANDALONE. When
# homepage is part of the full PiHub stack, its config comes from
# ../.env instead — see ../docker-compose.yml.
#
#   cp .env.example .env

# The one port for standalone use.
HOMEPAGE_PORT=80

# Same media layout as the rest of PiHub — see ../.env.example.
MEDIA_ROOT=/media/storage

CORS_ORIGINS=*
