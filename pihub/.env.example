# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in every value before running
#   cp .env.example .env && nano .env
# Or just run scripts/setup.sh, which does this for you.
# ─────────────────────────────────────────────────────────────

# ── Which products come up on a plain `docker compose up -d` ────────────
# Comma-separated Compose profiles. "core" (nginx + autoheal) should
# basically always be in here — "homepage" is its own profile precisely so
# it stays stoppable independently, like pitune and jellyfin. Narrow this if
# you only want one product by default — `pihub start <x>` still works
# regardless of this setting; see README.md's note on how service state
# actually survives a reboot (it's Docker's own restart policy, not this).
COMPOSE_PROFILES=core,homepage,pitune,jellyfin

# ── System ───────────────────────────────────────────────────
TZ=Europe/London

# UID/GID of the host user that owns MEDIA_ROOT (run `id -u` / `id -g`).
# Navidrome runs as this user so it can read your library.
PUID=1000
PGID=1000

# Extra group Navidrome and Jellyfin are also given read access through,
# on top of PUID/PGID (Navidrome) and whatever Jellyfin's image runs as.
# Leave at 0 (a no-op) unless MEDIA_LIBRARY_ROOT below points at a
# directory owned by some OTHER uid/gid you can't just chown, the
# textbook case being a folder inside this repo's home-drive stack's
# Nextcloud data directory (owned by Nextcloud's own www-data uid, mode
# 750, deliberately not world-readable). Find the right value with
# `stat -c '%g' /path/to/that/folder` and set it here; see README.md's
# "Mounting a Nextcloud folder as your media library" section before
# using this.
MEDIA_GID=0

# ── Storage layout ───────────────────────────────────────────
# The external media drive. scripts/setup.sh creates the subfolders below
# under it if they don't exist yet: music/ (with a music/YouTube/
# subfolder pitune-backend saves into), videos/, movies/, shows/,
# photos/ (a native Jellyfin Photos library, no separate app), downloads/,
# backups/.
MEDIA_ROOT=/media/storage

# Optional: redirect ONLY the streamable library (music/, videos/,
# movies/, shows/, photos/) to a different parent directory than
# MEDIA_ROOT, typically a folder inside this repo's home-drive stack's
# Nextcloud data directory, so adding/moving/deleting files through
# Nextcloud is what manages your library. Leave empty to keep everything
# under MEDIA_ROOT as before (the default). downloads/ and backups/ are
# NEVER affected by this and always stay under MEDIA_ROOT itself. See
# README.md's "Mounting a Nextcloud folder as your media library" section
# for why that split matters, and MEDIA_GID above for the permission fix
# it needs. The five subfolders (music, videos, movies, shows, photos)
# must exist under whatever path you set here, with exactly those
# lowercase names.
MEDIA_LIBRARY_ROOT=

# Per-service config/database — deliberately NOT under MEDIA_ROOT, so a
# missing/disconnected media drive can never take Navidrome's or Jellyfin's
# own config down with it. Defaults keep these on the boot drive, next to
# this compose file; point them at NVMe storage explicitly if your boot
# drive is an SD card.
NAVIDROME_DATA_PATH=./navidrome/data
JELLYFIN_CONFIG_PATH=./jellyfin/config

# ── Jellyfin hardware decode ─────────────────────────────────
# Written for you by scripts/setup.sh, which probes this board — you should
# not normally need to touch these by hand. Docker aborts the entire `up` if
# a device listed in docker-compose.yml doesn't exist, so each V4L2 node is
# a full "host:container" mapping here instead of a literal path, and the
# /dev/null:/dev/null default means "this board doesn't have it" (a no-op —
# the container already has /dev/null). Set one to e.g.
# /dev/video10:/dev/video10 to pass the real node through. Boards without
# the V4L2 stateless codecs, Pi 5 included depending on kernel and overlays,
# simply leave all three at the default and use software decoding. Check
# yours with `ls -l /dev/video*`. See README.md's Raspberry Pi
# considerations for why direct play matters more than any of this.
JELLYFIN_V4L2_DEV10=/dev/null:/dev/null
JELLYFIN_V4L2_DEV11=/dev/null:/dev/null
JELLYFIN_V4L2_DEV12=/dev/null:/dev/null

# ── Ports ────────────────────────────────────────────────────
# The one URL for day-to-day use: http://<pi>:<PIHUB_PORT>/
PIHUB_PORT=80

# Published directly in addition to being reverse-proxied — see
# docker-compose.yml for why each of these needs its own port too. Unlike
# the nginx-fronted routes, nothing sits in front of these: no rate
# limiting, no security headers. Consider firewalling them to your own LAN
# subnet — see README.md's Security model for a ufw example.
NAVIDROME_PORT=4533
JELLYFIN_PORT=8096

# ── Navidrome ────────────────────────────────────────────────
# Pin these once the stack is validated — `latest` can change behaviour
# under you on `docker compose pull` / `pihub update`.
NAVIDROME_TAG=latest
JELLYFIN_TAG=latest

ND_LOGLEVEL=info
ND_SCANSCHEDULE=@every 1h

# ── PiTune backend / yt-dlp ──────────────────────────────────
SEARCH_RESULT_LIMIT=20

# Optional: absolute path on the HOST to a Netscape-format cookies.txt,
# exported from a browser logged into YouTube. Needed only for age-
# restricted or region-locked videos — leave unset otherwise.
YTDLP_COOKIES_HOST_FILE=

# Once a YouTube-sourced track finishes playing, the frontend automatically
# saves it into music/YouTube/ (inside your actual library, so Navidrome's
# own regular scan picks it up with no extra steps). On by default; set to
# false to turn that off, or to reject direct calls to POST /api/save/<id>.
DOWNLOAD_ENABLED=true

# ── Security ─────────────────────────────────────────────────
# Required to use the homepage dashboard's start/stop/restart/logs buttons,
# and PiTune's /api/save if DOWNLOAD_ENABLED=true above. Without it, those
# endpoints run with NO auth at all — fine for a quick local test, not for
# anything else on your network. scripts/setup.sh generates one; if you're
# not using it: `openssl rand -hex 32`.
API_TOKEN=

# Leave empty. The frontend and its API are always same-origin here (both
# served through nginx), so legitimate use never needs a cross-origin
# allowance — this exists only for someone running a separate frontend
# against these APIs directly. See each backend's own CORS_ORIGINS comment.
CORS_ORIGINS=

# ── Tailscale (optional — remote access from outside the LAN) ────────────
# Only used if you run `pihub start tailscale` (or `docker compose
# --profile tailscale up -d`) — see README.md's Tailscale section and
# ../tailscale/README.md before enabling this. Apply
# ../tailscale/acl-policy.hujson to your tailnet FIRST — without it this
# node has no tag:pihub-server tag and the ACL denies it everything. This
# also requires API_TOKEN above to be set — the tailscale-preflight service
# in docker-compose.yml refuses to start otherwise (homepage's start/stop/
# restart/logs endpoints would otherwise have no auth at all, reachable
# from every approved tailnet device).
TAILSCALE_TAG=latest
# Generate this key just for this one node's first `tailscale up`: prefer
# NOT reusable and a short expiry (an hour is plenty) over the "reusable,
# 90 days" pattern some guides suggest. TS_STATE_DIR below is a persistent
# named volume, so the key is only ever consulted once — after that this
# node re-authenticates from its own cached state, not the key, even across
# restarts. A key that can't be reused has nothing left to steal.
TS_AUTHKEY=
TS_HOSTNAME=pihub
# --advertise-tags=tag:pihub-server — required for ../tailscale/acl-policy.hujson
# to grant this node anything at all. See ../tailscale/docs/DEVICE-ONBOARDING.md.
TS_EXTRA_ARGS=--advertise-tags=tag:pihub-server
