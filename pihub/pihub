#!/usr/bin/env bash
# pihub — terminal management for the PiHub stack.
#
#   pihub status              # show all services
#   pihub start pitune        # start just pitune (all 3 of its containers)
#   pihub stop jellyfin       # stop just jellyfin
#   pihub start all           # start everything, regardless of .env
#   pihub restart jellyfin    # restart one product
#   pihub logs pitune         # tail logs for a product (or a raw container name)
#   pihub update              # pull latest images, recreate only what was running
#
# Works at "product" granularity (core / homepage / pitune / jellyfin),
# matching the homepage dashboard — see docker-compose.yml's file header.
set -euo pipefail

# Resolves symlinks so `pihub` still finds its compose file when installed
# as `sudo ln -s $(pwd)/pihub /usr/local/bin/pihub` (see README.md).
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$SCRIPT_DIR"

# Compose only resolves a profiled service at all — even when it's named
# explicitly, e.g. `compose stop jellyfin` — if that service's profile is
# currently active. Forcing all four active on every invocation here means
# this CLI always works regardless of what COMPOSE_PROFILES happens to be
# set to in .env; the explicit service-name arguments at each call site are
# what actually scope which containers get touched.
compose() { docker compose --profile core --profile homepage --profile pitune --profile jellyfin "$@"; }

services_for() {
  case "$1" in
    core)     echo "nginx autoheal docker-proxy" ;;
    homepage) echo "homepage" ;;
    pitune)   echo "navidrome pitune-backend pitune-frontend" ;;
    jellyfin) echo "jellyfin" ;;
    *)        echo "" ;;
  esac
}

usage() {
  cat <<'EOF'
Usage: pihub <command> [target]

Commands:
  status                 Show every service's container state
  start   <target|all>   Start a product (core|homepage|pitune|jellyfin), or everything
  stop    <target>       Stop a product
  restart <target>       Restart a product
  logs    <target>       Tail logs for a product or a single container name
  update                 Pull latest images; recreate only what was running
EOF
}

cmd_status() {
  for group in core homepage pitune jellyfin; do
    echo "── $group ──"
    # shellcheck disable=SC2046
    compose ps $(services_for "$group") 2>/dev/null || true
    echo
  done
}

cmd_start() {
  local target="${1:?target required (core|homepage|pitune|jellyfin|all)}"
  if [ "$target" = "all" ]; then
    # No explicit service names: starts everything in an active profile,
    # and compose() already forces all three profiles active.
    compose up -d
    return
  fi
  local svcs
  svcs="$(services_for "$target")"
  [ -n "$svcs" ] || { echo "Unknown target: $target" >&2; exit 1; }
  # shellcheck disable=SC2086
  compose up -d $svcs
}

cmd_stop() {
  local target="${1:?target required}"
  local svcs
  svcs="$(services_for "$target")"
  [ -n "$svcs" ] || { echo "Unknown target: $target" >&2; exit 1; }
  # `stop`, not `down` — the containers stay defined, and Docker's own
  # `unless-stopped` restart policy then correctly leaves them stopped
  # across a reboot instead of resurrecting them. See docker-compose.yml.
  # shellcheck disable=SC2086
  compose stop $svcs
}

cmd_restart() {
  local target="${1:?target required}"
  local svcs
  svcs="$(services_for "$target")"
  [ -n "$svcs" ] || { echo "Unknown target: $target" >&2; exit 1; }
  # shellcheck disable=SC2086
  compose restart $svcs
}

cmd_logs() {
  local target="${1:?target required}"
  local svcs
  svcs="$(services_for "$target")"
  # Falls back to treating the argument as a raw compose service name
  # (e.g. `pihub logs navidrome`) if it isn't one of the three groups above.
  [ -n "$svcs" ] || svcs="$target"
  # shellcheck disable=SC2086
  compose logs -f --tail=200 $svcs
}

cmd_update() {
  # `docker compose up -d` with no service args brings up everything in an
  # active profile — including anything you'd deliberately stopped with
  # `pihub stop`. Capturing what's actually running FIRST and only
  # recreating those keeps a stopped service stopped after an update.
  local running
  running="$(compose ps --status running --format '{{.Service}}' 2>/dev/null || true)"

  echo "Pulling latest images..."
  compose pull

  if [ -n "$running" ]; then
    echo "Recreating previously-running services:"
    echo "$running" | sed 's/^/  /'
    # shellcheck disable=SC2086
    compose up -d $running
  else
    echo "Nothing was running — not starting anything."
  fi
}

main() {
  local command="${1:-}"
  shift || true
  case "$command" in
    status)  cmd_status ;;
    start)   cmd_start "$@" ;;
    stop)    cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    logs)    cmd_logs "$@" ;;
    update)  cmd_update ;;
    -h|--help|help|"") usage ;;
    *) echo "Unknown command: $command" >&2; usage >&2; exit 1 ;;
  esac
}

main "$@"
